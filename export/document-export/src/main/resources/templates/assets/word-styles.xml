<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
	Styles of the Word export. WordUtil loads this file into the document it creates, so the look of
	the export is decided here: fonts, headings, table of contents, tables. Sizes are in half points
	(w:sz) and twentieths of a point (spacing, indents).
-->
